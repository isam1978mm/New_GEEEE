APP_NAME=GEE Screening Web App
ALLOW_NETWORK_BIND=false
DATA_DIR=./data
DATABASE_PATH=./data/gee_screening.db
EE_SERVICE_ACCOUNT_EMAIL=
EE_SERVICE_ACCOUNT_KEY_PATH=

# Option 5 guarded dual-window radar surface-change review.
# It runs only when real Earth Engine execution is also enabled.
# The result is radar backscatter change, not settlement, displacement, depth,
# or physical confirmation. Set false to skip the extra historical SAR window.
OPTION5_SURFACE_CHANGE_ENABLED=true

# Operator-only local AOI depth calibration panel.
# Keep false unless the operator has reviewed same-site measured anchor polygons.
OPERATOR_LOCAL_DEPTH_APP_ENABLED=false

# Operator-supplied frozen notebook reference bundle path for local parity checks.
# The binary bundle is never committed; leave unset unless running notebook parity
# against an out-of-band copied reference bundle.
NOTEBOOK_REFERENCE_BUNDLE_DIR=
