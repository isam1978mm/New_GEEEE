# =============================================================================
# Generic OIDC runtime environment — EXAMPLE TEMPLATE ONLY
# =============================================================================
#
# WARNING:
#   - Do NOT commit a real .env file built from this template.
#   - Do NOT commit real OIDC issuer URLs, client IDs, JWKS URIs, subjects,
#     run IDs, tokens, or any provider credentials.
#   - All values below are placeholders using the reserved example.test domain.
#   - Replace example values ONLY on the server / runtime environment.
#
# Copy this file to a non-committed location on the server (e.g. /etc/gee/oidc.env
# or an untracked .env) and fill in the real values there.
# =============================================================================

# Enable the operator private overlay route (default off).
OPERATOR_PRIVATE_OVERLAY_PREVIEW_ENABLED=true

# Use OIDC token verification as the auth mechanism, not raw proxy headers.
# Set to false unless you ALSO front the app with a verified trusted proxy.
OPERATOR_AUTH_TRUSTED_PROXY_ENABLED=false

# Enable Generic OIDC token verification.
OPERATOR_AUTH_OIDC_ENABLED=true

# OIDC provider issuer URL — must match the `iss` claim in verified tokens.
# Replace with your real provider issuer on the server.
OPERATOR_AUTH_OIDC_ISSUER_URL=https://auth.example.test

# OIDC client ID / audience — must match the `aud` claim in verified tokens.
OPERATOR_AUTH_OIDC_CLIENT_ID=gee-operator-ui

# OIDC JWKS endpoint — used to fetch public keys for signature verification.
OPERATOR_AUTH_OIDC_JWKS_URI=https://auth.example.test/.well-known/jwks.json

# Maps each verified OIDC subject (the `sub` claim / actor_id) to the run IDs
# that actor is allowed to access. This is the FINAL per-run authorization gate
# (Auth-3). A valid token alone does NOT grant access — the subject and run ID
# must appear here. JSON object: {"<oidc-sub>": ["<run-id>", ...]}.
OPERATOR_RUN_AUTHORIZATIONS={"operator-subject-123":["run_example_001"]}

# =============================================================================
# Reminders:
#   - Tokens are obtained OUTSIDE this app (provider auth flow). Not stored here.
#   - Never store tokens in localStorage or sessionStorage.
#   - Never log raw bearer tokens.
#   - The smoke-test token (AUTH5_SMOKE_BEARER_TOKEN) is set only transiently in
#     a shell for valid-token smoke tests and unset immediately after.
# =============================================================================
